{
  "name": "ros2-bringup",
  "version": "1.1.0",
  "description": "ROS 2 多节点启动与机器人配置",
  "kind": "ros2_bringup",
  "priority": "P0",
  "status": "published",
  "maintainer": "VoVL773",
  "environment": [
    "Ubuntu 22.04 + ROS 2 Humble + Python 3.10",
    "Ubuntu 24.04 + ROS 2 Jazzy + Python 3.12"
  ],
  "dependencies": [
    "ament_cmake",
    "ament_cmake_pytest",
    "demo_nodes_cpp",
    "launch_ros",
    "ament_index_python",
    "python3-yaml"
  ],
  "ros_distro": [
    "humble",
    "jazzy"
  ],
  "changelog": [
    "1.1.0: 增加 Humble/Jazzy 双发行版兼容矩阵和匹配发行版的文档与 CI；1.0.0 保持不变",
    "1.0.0: 首期独立可运行模板，包含文档与自动化冒烟测试"
  ],
  "parameters": {
    "package_name": {
      "type": "string",
      "required": true,
      "pattern": "[a-z](?:[a-z0-9_]*[a-z0-9])?"
    },
    "maintainer": {
      "type": "string",
      "default": "Robotics DevKit contributors",
      "required": true,
      "pattern": "[\\w .@+\\-]+"
    },
    "maintainer_email": {
      "type": "string",
      "default": "maintainer@example.com",
      "pattern": "[\\w.+\\-]+@[\\w.\\-]+\\.[A-Za-z]{2,}"
    },
    "license": {
      "type": "string",
      "default": "Apache-2.0",
      "pattern": "[A-Za-z0-9][A-Za-z0-9. +\\-]*"
    },
    "ros_distro": {
      "type": "string",
      "default": "jazzy",
      "enum": [
        "humble",
        "jazzy"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      {
        "os": "ubuntu",
        "version": "22.04",
        "ros": "humble",
        "python": ">=3.10,<3.11"
      },
      {
        "os": "ubuntu",
        "version": "24.04",
        "ros": "jazzy",
        "python": ">=3.12,<3.13"
      }
    ],
    "cuda": {
      "required": false,
      "versions": [],
      "note": "ROS 节点本身不依赖 CUDA；GPU 感知/仿真插件需独立兼容验证"
    },
    "frameworks": {
      "rclcpp": "humble/jazzy",
      "rclpy": "humble/jazzy"
    },
    "simulators": []
  }
}
