{
  "name": "ros2-bringup",
  "version": "1.0.0",
  "description": "ROS 2 多节点启动与机器人配置",
  "kind": "ros2_bringup",
  "priority": "P0",
  "status": "published",
  "maintainer": "Robotics DevKit Platform contributors",
  "environment": [
    "Ubuntu 24.04",
    "ROS 2 Jazzy"
  ],
  "dependencies": [
    "ament_cmake",
    "ament_cmake_pytest",
    "demo_nodes_cpp",
    "launch_ros",
    "ament_index_python",
    "python3-yaml"
  ],
  "ros_distro": [
    "jazzy"
  ],
  "changelog": [
    "1.0.0: 首期独立可运行模板，包含文档与自动化冒烟测试"
  ],
  "parameters": {
    "package_name": {
      "type": "string",
      "required": true,
      "pattern": "[a-z](?:[a-z0-9_]*[a-z0-9])?"
    },
    "maintainer": {
      "type": "string",
      "default": "Robotics DevKit contributors",
      "required": true,
      "pattern": "[\\w .@+\\-]+"
    },
    "maintainer_email": {
      "type": "string",
      "default": "maintainer@example.com",
      "pattern": "[\\w.+\\-]+@[\\w.\\-]+\\.[A-Za-z]{2,}"
    },
    "license": {
      "type": "string",
      "default": "Apache-2.0",
      "pattern": "[A-Za-z0-9][A-Za-z0-9. +\\-]*"
    },
    "ros_distro": {
      "type": "string",
      "default": "jazzy",
      "enum": [
        "jazzy"
      ]
    }
  }
}
