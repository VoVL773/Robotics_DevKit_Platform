{
  "name": "ros2-bringup",
  "version": "1.0.0",
  "description": "ROS 2 多节点启动与机器人配置",
  "kind": "ros2_bringup",
  "priority": "P0",
  "status": "published",
  "maintainer": "VoVL773",
  "environment": [
    "Ubuntu 24.04",
    "ROS 2 Jazzy"
  ],
  "dependencies": [
    "ament_cmake",
    "ament_cmake_pytest",
    "demo_nodes_cpp",
    "launch_ros",
    "ament_index_python",
    "python3-yaml"
  ],
  "ros_distro": [
    "jazzy"
  ],
  "changelog": [
    "1.0.0: 首期独立可运行模板，包含文档与自动化冒烟测试"
  ],
  "parameters": {
    "package_name": {
      "type": "string",
      "required": true,
      "pattern": "[a-z](?:[a-z0-9_]*[a-z0-9])?",
      "label": "项目名称"
    },
    "maintainer": {
      "type": "string",
      "default": "Robotics DevKit contributors",
      "required": true,
      "pattern": "[\\w .@+\\-]+",
      "label": "维护者"
    },
    "maintainer_email": {
      "type": "string",
      "default": "maintainer@example.com",
      "pattern": "[\\w.+\\-]+@[\\w.\\-]+\\.[A-Za-z]{2,}",
      "label": "维护者邮箱"
    },
    "license": {
      "type": "string",
      "default": "Apache-2.0",
      "pattern": "[A-Za-z0-9][A-Za-z0-9. +\\-]*",
      "label": "许可证"
    },
    "ros_distro": {
      "type": "string",
      "default": "jazzy",
      "enum": [
        "jazzy"
      ],
      "label": "ROS 发行版"
    }
  },
  "compatibility": {
    "platforms": [
      {
        "os": "ubuntu",
        "version": "24.04",
        "ros": "jazzy",
        "python": ">=3.12,<3.13"
      }
    ],
    "cuda": {
      "required": false,
      "versions": []
    },
    "frameworks": {
      "rclcpp": "jazzy",
      "rclpy": "jazzy"
    },
    "simulators": []
  },
  "generation": {
    "skeleton": ".rdp/skeleton",
    "ci": ".rdp/ci.yml",
    "skeleton_ci": ".rdp/skeleton-ci.yml",
    "next_steps": [
      "cd {{workspace_shell}}",
      "colcon build --symlink-install --packages-select {{package_name}}",
      "source install/setup.bash",
      "ros2 launch {{package_name}} bringup.launch.py"
    ],
    "skeleton_next_steps": [
      "cd {{workspace_shell}}",
      "source /opt/ros/{{ros_distro}}/setup.bash",
      "colcon build --symlink-install",
      "source install/setup.bash"
    ],
    "ros": {
      "build_type": "ament_cmake",
      "node_dependency": null,
      "runtime_dependencies": [
        "launch_ros",
        "ament_index_python"
      ],
      "example_dependencies": [
        "demo_nodes_cpp",
        "python3-yaml"
      ],
      "test_dependency": "ament_cmake_pytest"
    },
    "smoke_engine": "ros2"
  }
}
